  "description": "AQL Progressive Web Application (PWA)",
  "productName": "AQL",
  "author": "Firose Hussain <github@firumon.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "echo \"No test specified\" && exit 0",
